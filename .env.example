# Ranking generation refresh. Use the same high-entropy value for Vercel's
# CRON_SECRET and the GitHub RANKINGS_REFRESH_SECRET repository secret.
CRON_SECRET=

# Private SGP1 Space used only for immutable ranking generations and pointers.
RANKINGS_SPACE_ENDPOINT=https://sgp1.digitaloceanspaces.com
RANKINGS_SPACE_REGION=sgp1
RANKINGS_SPACE_BUCKET=
RANKINGS_SPACE_PREFIX=rankings
RANKINGS_SPACE_ACCESS_KEY_ID=
RANKINGS_SPACE_SECRET_ACCESS_KEY=

# Schedule generation refresh. CRON_SECRET authenticates Vercel's daily call;
# SCHEDULE_REFRESH_SECRET can separately authenticate commit-pinned retries.
SCHEDULE_REFRESH_SECRET=

# Private SGP1 Space prefix used only for immutable Schedule generations and
# its active/failure pointers. These may use the same Space with distinct keys.
SCHEDULE_SPACE_ENDPOINT=https://sgp1.digitaloceanspaces.com
SCHEDULE_SPACE_REGION=sgp1
SCHEDULE_SPACE_BUCKET=
SCHEDULE_SPACE_PREFIX=schedule
SCHEDULE_SPACE_ACCESS_KEY_ID=
SCHEDULE_SPACE_SECRET_ACCESS_KEY=

# Standard PostgreSQL URL used only for distinct transient ranking and Schedule
# refresh advisory locks.
POSTGRES_URL=
