# Ranking generation refresh. Use the same high-entropy value for Vercel's
# CRON_SECRET and the GitHub RANKINGS_REFRESH_SECRET repository secret.
CRON_SECRET=

# Local and tests only. Production downloads from Hugging Face into /tmp and
# never ships or serves rankings/seed.
# RANKINGS_SEED_DIR=rankings/seed/0699cb351bcd01cd2efc0cbf5c4ff479d2ff558d

# Schedule generation refresh. CRON_SECRET authenticates Vercel's daily call;
# SCHEDULE_REFRESH_SECRET can separately authenticate commit-pinned retries.
SCHEDULE_REFRESH_SECRET=

# Local and tests only. Production downloads from Hugging Face into /tmp and
# never ships or serves schedule/seed.
# SCHEDULE_SEED_DIR=schedule/seed/0ddb2e493caeeb8aa9c56728496c866c358a2431

# Standard PostgreSQL URL used only for distinct transient ranking and Schedule
# refresh advisory locks.
POSTGRES_URL=

# Portable PostgreSQL contribution data. Use a pooled Singapore connection in
# serverless production and a disposable database for integration tests.
CONTRIBUTIONS_POSTGRES_URL=
TEST_CONTRIBUTIONS_POSTGRES_URL=

# Auth.js encrypted JWT session secret and one confidential multi-tenant Entra
# client. Exact callback ends in /api/auth/callback/microsoft-entra-id. Never use
# NEXT_PUBLIC_ for these values.
AUTH_SECRET=
AUTH_HKUST_ID=
AUTH_HKUST_SECRET=

# Human-approved versions must match the policy text published at /privacy.
# Onboarding remains disabled while either account-policy value is blank;
# Review publication remains disabled while REVIEW_POLICY_VERSION is blank.
PRIVACY_POLICY_VERSION=
COMMUNITY_RULES_VERSION=
REVIEW_POLICY_VERSION=

# Public Privacy Contact. Email is the correspondence channel. Optional postal
# address is shown on /privacy when set. Rotate later if needed.
PRIVACY_CONTACT_TITLE=Operator
PRIVACY_CONTACT_EMAIL=ust-rankings@flandia.dev
# PRIVACY_CONTACT_ADDRESS=

# Dedicated private SGP1 Space for Review Attachments. Use the origin endpoint,
# not the CDN, for presigned PUT and signed GET. Configure exact-origin CORS for
# PUT and HEAD only. Never commit these values.
ATTACHMENTS_SPACE_ENDPOINT=https://sgp1.digitaloceanspaces.com
ATTACHMENTS_SPACE_REGION=sgp1
ATTACHMENTS_SPACE_BUCKET=
ATTACHMENTS_SPACE_PREFIX=attachments
ATTACHMENTS_SPACE_ACCESS_KEY_ID=
ATTACHMENTS_SPACE_SECRET_ACCESS_KEY=

# Set to 1 to reject new Upload Intents without disabling Review text or
# existing Attachment downloads. Cleanup still runs.
ATTACHMENTS_UPLOADS_DISABLED=
