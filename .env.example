# Ranking generation refresh. Use the same high-entropy value for Vercel's
# CRON_SECRET and the GitHub RANKINGS_REFRESH_SECRET repository secret.
CRON_SECRET=

# Private SGP1 Space used only for immutable ranking generations and pointers.
RANKINGS_SPACE_ENDPOINT=https://sgp1.digitaloceanspaces.com
RANKINGS_SPACE_REGION=sgp1
RANKINGS_SPACE_BUCKET=
RANKINGS_SPACE_PREFIX=rankings
RANKINGS_SPACE_ACCESS_KEY_ID=
RANKINGS_SPACE_SECRET_ACCESS_KEY=

# Standard PostgreSQL URL used only for the transient refresh advisory lock.
POSTGRES_URL=
