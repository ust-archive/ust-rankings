{
  "name": "ust-rankings",
  "version": "1.1.0",
  "private": true,
  "workspaces": [
    "data"
  ],
  "scripts": {
    "update-data": "bun scripts/update-data.mjs",
    "dev": "bun --bun next dev --turbopack",
    "prebuild": "bun run update-data",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "check": "bun run toolchain:check && biome check . && bun run type-check && bun run test && bun run data:check",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "type-check": "tsc --noEmit",
    "test": "bun test ./test",
    "test:browser": "playwright test",
    "data:run": "bun run --cwd data run",
    "data:check": "bun run --cwd data type-check && bun run --cwd data test",
    "toolchain:check": "bun scripts/check-toolchain.ts",
    "contributions:migrate": "bun scripts/migrate-contributions.ts",
    "contributions:merge-instructor-signals": "bun scripts/merge-instructor-signals.ts",
    "contributions:moderate": "bun scripts/moderate.ts",
    "attachments:remove-stored-file": "bun scripts/remove-stored-file.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@next/third-parties": "16.3.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "fuse.js": "^7.5.0",
    "ics": "^3.12.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.33.0",
    "luxon": "^3.7.2",
    "mathjs": "^15.2.0",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rrule": "^2.8.1",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "virtua": "^0.50.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/lodash": "^4.17.25",
    "@types/luxon": "^3.7.4",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vercel": "^59.1.4"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14 <2"
  }
}
