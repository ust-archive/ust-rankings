{
  "name": "ust-rankings",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "data"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "npm run toolchain:check && biome check . && npm run type-check && npm test && npm run data:check",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "type-check": "tsc --noEmit",
    "type-check:runtime": "tsc --noEmit -p tsconfig.runtime.json",
    "test": "vitest run --dir test --exclude \"*-postgres.test.ts\" --exclude \"**/browser/**\"",
    "test:browser": "node scripts/generate-browser-fixture.ts && playwright test",
    "test:accounts": "vitest run test/account-service.test.ts test/auth-policy.test.ts test/auth-session.test.ts",
    "test:attachments": "vitest run test/attachment-routes.test.ts test/attachment-service.test.ts test/attachment-spaces.test.ts test/attachment-validation.test.ts",
    "test:contracts": "vitest run --test-timeout 30000 test/account-postgres.test.ts test/attachment-postgres.test.ts test/moderation-postgres.test.ts test/review-postgres.test.ts test/signal-postgres.test.ts",
    "test:moderation": "vitest run test/moderation-action.test.ts test/moderation-service.test.ts",
    "test:rankings": "vitest run test/failure-boundaries.test.ts test/ranking-refresh-concurrency.test.ts test/ranking-refresh-route.test.ts test/ranking-refresh.test.ts test/rankings.test.ts",
    "test:reviews": "vitest run test/review-action.test.ts test/review-associations.test.ts test/review-data.test.ts test/review-service.test.ts test/review-write-security.test.ts",
    "test:schedule": "vitest run test/schedule-calendar.test.ts test/schedule-planner.test.ts test/schedule-refresh-route.test.ts test/schedule-refresh.test.ts test/schedule-storage.test.ts test/schedule.test.ts",
    "test:signals": "vitest run test/signal-action.test.ts test/signal-data.test.ts test/signal-service.test.ts",
    "data:run": "npm run run --workspace data",
    "data:check": "npm run type-check --workspace data && npm test --workspace data",
    "toolchain:check": "node scripts/check-toolchain.ts",
    "contributions:migrate": "node scripts/migrate-contributions.ts",
    "contributions:merge-instructor-signals": "node scripts/merge-instructor-signals.ts",
    "contributions:moderate": "node scripts/moderate.ts",
    "attachments:remove-stored-file": "node scripts/remove-stored-file.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@mdxeditor/editor": "^4.2.1",
    "@next/third-parties": "16.3.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@typehaus/metropolis": "12.0.0-next.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ics": "^3.12.0",
    "lucide-react": "^1.33.0",
    "luxon": "^3.7.2",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "rrule": "^2.8.1",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/luxon": "^3.7.4",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=26.7.0 <27",
    "npm": ">=12 <13"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
